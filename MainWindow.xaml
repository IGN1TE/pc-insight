   <TabItem Header="Insights" Tag="&#xE946;"><Grid Margin="20"><TextBox Name="Insights" Text="Recommendations will appear after a scan. Every finding explains its evidence and limitations."/></Grid></TabItem>
   <TabItem Header="Benchmark" Tag="&#xE9D9;"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Foreground="#EFF0FA" Text="Performance tests" FontSize="22"/><TextBlock Grid.Row="1" Foreground="#B0B5CC" Text="Three-run batches use 10-second cooldowns; CPU batches take about 3½ minutes. Cancel discards the batch. A stopped or failed run ends the batch. Save work before starting. CPU 60 sec and RAM copy require CPU temperatures; GPU shader requires a matching GPU temperature sensor. Tests stop at the 85°C preview cutoff or missing/slow readings. These are workload-specific benchmarks, not stability certificates or game FPS. RAM uses 256 MiB; GPU v2 uses an unscored 5-second warm-up, then a 30-second 1280×720 shader measurement. Its scores cannot be compared with GPU v1. Cancel ends the task."/><WrapPanel Grid.Row="2"><Button Name="RepeatCPU" Content="CPU × 3 runs" IsEnabled="False"/><Button Name="RepeatRAM" Content="RAM × 3 runs" IsEnabled="False"/><Button Name="RepeatGPU" Content="GPU × 3 runs" IsEnabled="False"/><Button Name="LongCPU" Content="CPU · 60 seconds" IsEnabled="False"/><Button Name="MemoryTest" Content="RAM copy · 20 seconds" IsEnabled="False"/><Button Name="GPUTest" Content="GPU v2 · 5 + 30 seconds" IsEnabled="False"/><Button Name="Benchmark" Content="CPU · 15 sec (unmonitored)" IsEnabled="False"/><Button Name="Cancel" Content="Cancel task" IsEnabled="False"/></WrapPanel><ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU endurance" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Continuous shader load at your current settings. Stops on detected rendering errors, unavailable/slow sensors or the sampled 85°C cutoff. No clock changes or automatic restoration. This does not check pixel correctness, all VRAM, games or Windows hardware-error logs; completion does not prove stability." Foreground="#A8B5CE"/><WrapPanel><Button Name="Endurance5" Content="GPU · 5 minutes" IsEnabled="False"/><Button Name="Endurance10" Content="GPU · 10 minutes" IsEnabled="False"/><Button Name="EnduranceStop" Content="Stop and save result" IsEnabled="False" Background="#263653"/></WrapPanel><TextBlock Name="EnduranceStatus" Text="Scan PC, then choose a duration. Save work and close games first." Foreground="#B69AFF"/></StackPanel></Border><TextBox MinHeight="150" Name="Results" Text="Run a baseline, optionally change a supported setting, then test again. Results are stored on this PC."/></StackPanel></ScrollViewer></Grid></TabItem>
   <TabItem Header="Live sensors" Tag="&#xE9D9;"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Foreground="#EFF0FA" FontSize="22" Text="Temperature and clock recording"/>
    <TextBlock Grid.Row="1" Foreground="#B0B5CC" Text="Use Start live monitoring above for continuous read-only monitoring, or record temperatures, clocks and power for 20 seconds. Readings come from the built-in sensors. If CPU temperatures are missing, launch Start-PC-Insight-Admin.cmd; see README for driver requirements."/>
    <WrapPanel Grid.Row="2"><Button Name="SensorStart" Content="Record sensors: 20 sec"/><Button Name="MultiBenchmark" Content="Run monitored CPU test" IsEnabled="False"/><Button Name="SensorCancel" Content="Cancel task" IsEnabled="False"/></WrapPanel>
    <TextBlock Grid.Row="3" Name="SensorSummary" Foreground="#A786FF" Text="CPU test uses up to 16 workers. Stops on missing readings, slow queries, or reported CPU temperature at 85 C. This cutoff is a preview policy, not a manufacturer limit. Use Cancel task to stop either recording or testing."/>
    <TextBox Grid.Row="4" Name="SensorReadings" Text="Readings update during a session using the bundled sensor library. No separate monitoring app is required. Temperature = Celsius, Clock = MHz, Load = percent, Power = watts. Clock values are provider-reported and are not necessarily effective clocks. Query timestamps do not prove that provider readings are fresh.&#10;&#10;Recording alone adds no test load: you can record during your normal workload. Game FPS is available on Game overlay; GPU shader tests are on Benchmark."/>
   </Grid></TabItem>
