  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B0B5CC"/><Setter Property="Margin" Value="8,3"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" CornerRadius="9" Padding="12,12" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/><TextBlock x:Name="NavLabel" Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#2B2047"/><Setter Property="Foreground" Value="#C6AEFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#242034"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#7945FF"/><Setter TargetName="Nav" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#11121D" CornerRadius="16" Margin="0,0,16,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="18,24,12,24"><Image x:Name="SidebarLogo" Source="{DynamicResource PCInsightLogo}" Height="62" Stretch="Uniform" HorizontalAlignment="Stretch" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="PC Insight"/><TextBlock Text="Hardware diagnostics" FontSize="11" Foreground="#929BB5"/></StackPanel><TextBlock x:Name="SidebarVersion" DockPanel.Dock="Bottom" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" FontSize="10" Foreground="#929BB5" Margin="18,24"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/></ScrollViewer></DockPanel></Border><ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#10111B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#3C3654" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#151722"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,12,14"/><Setter Property="BorderBrush" Value="#292C40"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#151722"/><Setter Property="Foreground" Value="#EFF0FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16"/><Setter Property="FontSize" Value="14"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PC INSIGHT / HARDWARE DIAGNOSTICS" Foreground="#B195FF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Your PC, at a glance." FontSize="30" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><WrapPanel><Button Name="Scan" Content="Scan PC"/><Button Name="Export" Content="Export report" Background="#242335" IsEnabled="False"/></WrapPanel><WrapPanel><Button Name="MonitorStart" Content="Start live monitoring" Background="#28233D"/><Button Name="MonitorStop" Content="Stop and save" Background="#28233D" IsEnabled="False"/></WrapPanel><TextBlock Name="ScanTime" Foreground="#929BB5" Text="Start with a hardware scan" FontSize="11" Margin="0"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="#191925" CornerRadius="9" Padding="12,6" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Name="ReopenAdmin" Content="Reopen as administrator" Background="#28233D"/><TextBlock Name="AccessStatus" Foreground="#B0B5CC" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
  <TabControl Name="Navigation" Grid.Row="2" Background="#0C0D14" BorderThickness="0">
   <TabItem Header="Overview" Tag="&#xE80F;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,0,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" MinHeight="318"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="PROCESSOR" Foreground="#B195FF" FontSize="11" FontWeight="Bold"/><TextBlock Name="CPUModel" Text="Identify your processor" FontSize="23" FontWeight="SemiBold"/><TextBlock Name="CPUDetails" Text="Scan PC to read cores and threads" Foreground="#929BB5" FontSize="12"/></StackPanel>
      <Grid Grid.Row="1" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="TEMPERATURE" Foreground="#929BB5" FontSize="11"/><TextBlock Name="CPUTemp" Text="—" FontSize="44" FontWeight="SemiBold"/><TextBlock Name="CPUReadingTime" Text="Record sensors to read temperature" Foreground="#929BB5" FontSize="11"/></StackPanel><Viewbox Grid.Column="1" Width="88" Height="88" Opacity="0.15"><Canvas Width="100" Height="100"><Path Stroke="#7050B5" StrokeThickness="3" Data="M 30,0 L 30,15 M 50,0 L 50,15 M 70,0 L 70,15 M 30,85 L 30,100 M 50,85 L 50,100 M 70,85 L 70,100 M 0,30 L 15,30 M 0,50 L 15,50 M 0,70 L 15,70 M 85,30 L 100,30 M 85,50 L 100,50 M 85,70 L 100,70"/><Rectangle Canvas.Left="15" Canvas.Top="15" Width="70" Height="70" RadiusX="8" RadiusY="8" Stroke="#AD8DFF" StrokeThickness="2" Fill="#211A35"/><Rectangle Canvas.Left="30" Canvas.Top="30" Width="40" Height="40" RadiusX="4" RadiusY="4" Stroke="#7050B5" StrokeThickness="2"/></Canvas></Viewbox></Grid>
      <Border Grid.Row="2" BorderBrush="#292C40" BorderThickness="0,1,0,0" Padding="0,12,0,0"><TextBlock Name="CPUPower" Text="Package power · No reading yet" Foreground="#B0B5CC" FontSize="12"/></Border>
     </Grid></Border>
     <StackPanel Grid.Column="1">
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GRAPHICS" Foreground="#48CDE8" FontSize="11" FontWeight="Bold"/><TextBlock Name="GPUModel" Text="Identify your graphics card" FontSize="18" FontWeight="SemiBold"/><TextBlock Name="GPUReadingTime" Text="Record sensors to read temperature" Foreground="#929BB5" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Name="GPUTemp" Text="—" FontSize="30" FontWeight="SemiBold" Margin="16,24,0,0"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MEMORY" Foreground="#B195FF" FontSize="11" FontWeight="Bold"/><TextBlock Name="RAMModel" Text="Scan to identify memory" FontSize="18" FontWeight="SemiBold"/><TextBlock Name="RAMSampleLabel" Text="Usage at the last hardware scan" Foreground="#929BB5" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Name="RAMUsed" Text="—" FontSize="30" FontWeight="SemiBold" Margin="16,24,0,0"/></Grid></Border>
     </StackPanel>
    </Grid>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Name="DashboardRecord" Content="Record sensors" Background="#28233D"/><Button Name="DashboardTest" Content="Run monitored test" IsEnabled="False"/></WrapPanel><TextBlock Text="Temperature history" FontSize="20" FontWeight="SemiBold"/></DockPanel><TextBlock Name="ChartCaption" Text="Record sensors to plot measured CPU temperatures." Foreground="#929BB5" FontSize="12"/>
     <Grid Height="110" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><TextBlock Text="125°C" VerticalAlignment="Top" FontSize="11" Foreground="#929BB5"/><TextBlock Text="0°C" VerticalAlignment="Bottom" FontSize="11" Foreground="#929BB5"/></Grid><Border Grid.Column="1" Background="#10121C" BorderBrush="#30334B" BorderThickness="0,0,0,1"><Viewbox Stretch="Fill"><Canvas Name="TemperatureChart" Width="800" Height="150" ClipToBounds="True"/></Viewbox></Border></Grid><TextBlock Text="UTILIZATION · CPU purple / GPU cyan / RAM gold · 0–100%" Foreground="#929BB5" FontSize="11"/><Border Height="90" Background="#10121C" Margin="0,4,0,8"><Viewbox Stretch="Fill"><Canvas Name="UsageChart" Width="800" Height="100" ClipToBounds="True"/></Viewbox></Border><TextBlock Text="Session start → latest sample • gaps mean unavailable readings" Foreground="#929BB5" FontSize="11"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Name="OpenResults" DockPanel.Dock="Right" Content="View details →" Background="#28233D"/><TextBlock Text="Latest session" FontSize="20" FontWeight="SemiBold"/></DockPanel><TextBlock Name="DashboardResult" Text="No saved session. Record sensors or run a monitored test to begin." Foreground="#B0B5CC" FontSize="12"/>
     <UniformGrid Columns="3"><StackPanel><TextBlock Text="PEAK CPU" Foreground="#929BB5" FontSize="10"/><TextBlock Name="ResultPeak" Text="—" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Name="ResultRateLabel" Text="SHA-256 THROUGHPUT" Foreground="#929BB5" FontSize="10"/><TextBlock Name="ResultRate" Text="—" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="VS PREVIOUS MATCH" Foreground="#929BB5" FontSize="10"/><TextBlock Name="ResultDelta" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="#B195FF"/></StackPanel></UniformGrid><TextBlock Text="Repeat runs to confirm a trend. Short tests do not establish stability or tuning headroom." Foreground="#929BB5" FontSize="11"/>
    </StackPanel></Border>
    <Expander Header="Hardware details" Margin="0,4,12,16"><TextBox Name="Overview" MinHeight="180" Text="Choose Scan this PC to identify your hardware."/></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Insights" Tag="&#xE946;"><Grid Margin="20"><TextBox Name="Insights" Text="Recommendations will appear after a scan. Every finding explains its evidence and limitations."/></Grid></TabItem>
   <TabItem Header="Benchmark" Tag="&#xE9D9;"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Foreground="#EFF0FA" Text="Performance tests" FontSize="22"/><TextBlock Grid.Row="1" Foreground="#B0B5CC" Text="Three-run batches use 10-second cooldowns; CPU batches take about 3½ minutes. Cancel discards the batch. A stopped or failed run ends the batch. Save work before starting. CPU 60 sec and RAM copy require CPU temperatures; GPU shader requires a matching GPU temperature sensor. Tests stop at the 85°C preview cutoff or missing/slow readings. These are workload-specific benchmarks, not stability certificates or game FPS. RAM uses 256 MiB; GPU v2 uses an unscored 5-second warm-up, then a 30-second 1280×720 shader measurement. Its scores cannot be compared with GPU v1. Cancel ends the task."/><WrapPanel Grid.Row="2"><Button Name="RepeatCPU" Content="CPU × 3 runs" IsEnabled="False"/><Button Name="RepeatRAM" Content="RAM × 3 runs" IsEnabled="False"/><Button Name="RepeatGPU" Content="GPU × 3 runs" IsEnabled="False"/><Button Name="LongCPU" Content="CPU · 60 seconds" IsEnabled="False"/><Button Name="MemoryTest" Content="RAM copy · 20 seconds" IsEnabled="False"/><Button Name="GPUTest" Content="GPU v2 · 5 + 30 seconds" IsEnabled="False"/><Button Name="Benchmark" Content="CPU · 15 sec (unmonitored)" IsEnabled="False"/><Button Name="Cancel" Content="Cancel task" IsEnabled="False"/></WrapPanel><TextBox Grid.Row="3" Name="Results" Text="Run a baseline, optionally change a supported setting, then test again. Results are stored on this PC."/></Grid></TabItem>
   <TabItem Header="Live sensors" Tag="&#xE9D9;"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Foreground="#EFF0FA" FontSize="22" Text="Temperature and clock recording"/>
    <TextBlock Grid.Row="1" Foreground="#B0B5CC" Text="Use Start live monitoring above for continuous read-only monitoring, or record temperatures, clocks and power for 20 seconds. Readings come from the built-in sensors. If CPU temperatures are missing, launch Start-PC-Insight-Admin.cmd; see README for driver requirements."/>
    <WrapPanel Grid.Row="2"><Button Name="SensorStart" Content="Record sensors: 20 sec"/><Button Name="MultiBenchmark" Content="Run monitored CPU test" IsEnabled="False"/><Button Name="SensorCancel" Content="Cancel task" IsEnabled="False"/></WrapPanel>
    <TextBlock Grid.Row="3" Name="SensorSummary" Foreground="#A786FF" Text="CPU test uses up to 16 workers. Stops on missing readings, slow queries, or reported CPU temperature at 85 C. This cutoff is a preview policy, not a manufacturer limit. Use Cancel task to stop either recording or testing."/>
    <TextBox Grid.Row="4" Name="SensorReadings" Text="Readings update during a session using the bundled sensor library. No separate monitoring app is required. Temperature = Celsius, Clock = MHz, Load = percent, Power = watts. Clock values are provider-reported and are not necessarily effective clocks. Query timestamps do not prove that provider readings are fresh.&#10;&#10;Recording alone adds no test load: you can record during your normal workload. No FPS capture or GPU benchmark is included yet."/>
   </Grid></TabItem>
   <TabItem Header="Test results" Tag="&#xE9F9;"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><ComboBox Name="SessionPicker" DisplayMemberPath="Label" Padding="10" Margin="0,0,0,10"/><WrapPanel><Button Name="ExportSessionCsv" Content="Export readings CSV" IsEnabled="False"/><Button Name="ExportSessionJson" Content="Export this session" IsEnabled="False"/></WrapPanel><TextBlock Name="SessionExportStatus" Text="Choose a saved session to export." Foreground="#929BB5" Margin="0,4,0,12"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBox Height="190" Name="SessionResults" Text="Run a monitored test or record sensors to see saved results."/>
<Border Background="#151622" CornerRadius="9" Padding="14" Margin="0,12,0,0"><StackPanel>
<TextBlock Text="Compare saved sessions" FontSize="20" FontWeight="SemiBold"/>
<TextBlock Text="Select reference A below. The session selected at the top is B and is excluded from this list." Foreground="#B0B5CC" Margin="0,6"/>
<TextBlock Text="Reference session A" Foreground="#D8C8FF"/>
<ComboBox Name="CompareSessionPicker" DisplayMemberPath="Label" Padding="10" Margin="0,6,0,10" AutomationProperties.Name="Reference session A"/>
<TextBlock Name="ComparisonStatus" Text="Save at least two sessions to compare." Foreground="#D8C8FF" Margin="0,0,0,8"/>
<DataGrid Name="ComparisonRows" Height="260" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#292C40" Background="#151622" Foreground="#EFF0FA" RowBackground="#151622" AlternatingRowBackground="#1C1D2C" BorderBrush="#292C40" FontSize="12">
<DataGrid.Resources>

<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#28233D"/><Setter Property="Foreground" Value="#D8C8FF"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Padding" Value="6"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#42305F"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
</DataGrid.Resources>
<DataGrid.Columns>
<DataGridTextColumn Header="Measurement" Binding="{Binding Metric}" ElementStyle="{StaticResource ComparisonCellText}" Width="2*"/>
<DataGridTextColumn Header="A · reference" Binding="{Binding BeforeText}" ElementStyle="{StaticResource ComparisonCellText}" Width="*"/>
<DataGridTextColumn Header="B · selected" Binding="{Binding AfterText}" ElementStyle="{StaticResource ComparisonCellText}" Width="*"/>
<DataGridTextColumn Header="Change (B − A)" Binding="{Binding ChangeText}" ElementStyle="{StaticResource ComparisonCellText}" Width="1.3*"/>
<DataGridTextColumn Header="Samples A / B" Binding="{Binding Coverage}" ElementStyle="{StaticResource ComparisonCellText}" Width="1.5*"/>
</DataGrid.Columns></DataGrid>
<TextBlock Name="ComparisonNotes" Foreground="#929BB5" FontSize="12" Margin="0,10,0,0"/>
<Button Name="ExportComparison" Content="Export comparison" IsEnabled="False" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="0,10,0,0"/>
<TextBlock Name="ComparisonExportStatus" Foreground="#B195FF" FontSize="12"/>
</StackPanel></Border>
<TextBlock Name="SessionCoverage" Text="Choose a saved session to inspect its sensors." Foreground="#929BB5" Margin="0,12,0,8"/>
<DataGrid Height="250" SelectionMode="Single" SelectionUnit="FullRow" Name="SessionSensorDetails" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#292C40" Background="#151622" Foreground="#EFF0FA" RowBackground="#151622" AlternatingRowBackground="#1C1D2C" BorderBrush="#292C40" FontSize="12">
<DataGrid.Resources>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#28233D"/><Setter Property="Foreground" Value="#D8C8FF"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Padding" Value="6"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#42305F"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
</DataGrid.Resources>
<DataGrid.Columns>
<DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="150"/>
<DataGridTextColumn Header="Sensor" Binding="{Binding Sensor}" Width="180"/>
<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
<DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="85"/>
<DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="85"/>
<DataGridTextColumn Header="Peak" Binding="{Binding MaxText}" Width="85"/>
<DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55"/>
<DataGridTextColumn Header="Samples" Binding="{Binding Coverage}" Width="130"/>
<DataGridTextColumn Header="Sensor ID" Binding="{Binding Identifier}" Width="220"/>
</DataGrid.Columns></DataGrid>
<Border Background="#151622" CornerRadius="9" Padding="12" Margin="0,12,0,0"><StackPanel>
<TextBlock Name="SensorHistoryTitle" Text="Select a sensor row to inspect its history." Foreground="#D8C8FF" FontSize="16"/>
<TextBlock Name="SensorHistoryScale" Foreground="#929BB5" Margin="0,4"/>
<Viewbox Height="150" Stretch="Fill"><Canvas Name="SensorHistoryChart" Width="800" Height="150" Background="#10111A" ClipToBounds="True"/></Viewbox>
<TextBlock Name="SensorHistoryTime" Foreground="#929BB5" Margin="0,8,0,0"/>
</StackPanel></Border></StackPanel></ScrollViewer></Grid></TabItem>
   <TabItem Header="Optimize" Tag="&#xE713;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Foreground="#EFF0FA" Text="Choose a supported change" FontSize="22"/><TextBlock Foreground="#B0B5CC" Text="Windows power plans are available in this preview. They can affect responsiveness, heat, battery life and sleep behaviour. They do not overclock or undervolt your hardware. No improvement is guaranteed."/><Button Name="PlansRefresh" Content="Load installed power plans" HorizontalAlignment="Left"/><ComboBox Name="Plans" DisplayMemberPath="Name" Margin="0,8" Padding="10"/><WrapPanel><Button Name="Apply" Content="Review and apply"/><Button Name="Restore" Content="Restore previous plan"/></WrapPanel><TextBlock Name="PowerStatus" Foreground="#A786FF" Text="No changes made."/><Border Background="#202034" Padding="18" Margin="0,20,0,0"><StackPanel><TextBlock Foreground="#EFF0FA" FontSize="18" Text="GPU power limits: see Tuning"/><TextBlock Foreground="#B0B5CC" Text="CPU overclocking / undervolting: unavailable&#10;GPU overclocking / undervolting: unavailable&#10;RAM timings / XMP / EXPO: guidance only&#10;Fan control and BIOS writes: unavailable&#10;&#10;Support will require vendor-specific integrations and testing on the actual hardware. There are no hidden tuning writes or automatic startup profiles."/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Tuning" Tag="&#xE9E9;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="Measure. Review. Apply. Compare." FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Start with a compatibility check and baseline. The initial control adjusts supported NVIDIA GPU power limits only. Overclocking, voltage changes and BIOS writes are not available." Foreground="#B0B5CC"/>
    <WrapPanel><Button Name="DetectTuning" Content="Detect compatibility"/><Button Name="SaveBaseline" Content="Save baseline" Background="#28233D" IsEnabled="False"/><Button Name="CompareBaseline" Content="Compare with baseline" Background="#28233D"/></WrapPanel>
    <Border Style="{StaticResource Card}"><TextBlock Name="CapabilityText" Text="Compatibility has not been checked. Readable power limits do not guarantee permission to change them."/></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU power limit" FontSize="20"/>
     <ComboBox Name="GPUDevice" DisplayMemberPath="Label" Margin="0,8" Padding="10"/>
     <ComboBox Name="PowerPreset" SelectedIndex="0" Margin="0,8" Padding="10"><ComboBoxItem Tag="90" Content="90% of original power limit"/><ComboBoxItem Tag="80" Content="80% of original power limit"/></ComboBox>
     <TextBlock Text="Presets below the GPU minimum or above the current limit are rejected. Restore first to move back up. No settings change until you review and apply. Changes may persist after closing; restore is explicit." Foreground="#929BB5"/>
     <WrapPanel><Button Name="ApplyGPU" Content="Review and apply GPU limit"/><Button Name="RestoreGPU" Content="Restore saved GPU limit" Background="#28233D"/></WrapPanel><TextBlock Name="TuningStatus" Text="No GPU changes made in this session." Foreground="#B195FF"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Before / after" FontSize="20"/><TextBlock Name="BaselineResult" Text="Save a baseline containing a complete three-run batch. Repeat the same batch after a reviewed change. Comparisons require three matching successful runs on each side."/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Repeated results" Tag="&#xE9D9;"><Grid Margin="20"><TextBox Name="BatchReport" Text="Start a three-run batch from Benchmark. Median and spread will appear here."/></Grid></TabItem>
   <TabItem Header="Profiles" Tag="&#xE8B7;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Named comparison baselines" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Keep separate baselines for different experiments. A profile is a saved copy of the active baseline, including its readings and reported settings. Loading it never applies hardware settings." Foreground="#B0B5CC"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Save the active baseline" FontSize="20"/><TextBlock Text="First use Tuning → Save baseline. Then give that baseline a name here." Foreground="#929BB5"/><TextBox Name="ProfileName" IsReadOnly="False" MaxLength="60" Text="Original settings" BorderBrush="#51436F" BorderThickness="1"/><Button Name="SaveProfile" Content="Save named profile" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Saved profiles" FontSize="20"/><ComboBox Name="ProfilePicker" DisplayMemberPath="Label" Padding="10" Margin="0,8"/><Button Name="LoadProfile" Content="Load for comparison" HorizontalAlignment="Left"/><TextBlock Name="ProfileStatus" Text="No profile loaded this session. Results and profiles are stored locally." Foreground="#B195FF"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Updates" Tag="&#xE895;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="App updates" FontSize="24"/><TextBlock Name="InstalledVersion" Text="Reading installed version..." Foreground="#B195FF" Margin="0,8"/>
<TextBlock Text="Connect a trusted PC Insight release feed to check for updates. The app downloads and verifies the package, then installs it when you choose Install and restart. Results and recovery records stay on this PC." Margin="0,8"/>
<TextBlock Text="Release feed URL (HTTPS)" Foreground="#B0B5CC"/><TextBox Name="UpdateFeed" MinHeight="42" IsReadOnly="False" TextWrapping="NoWrap" ToolTip="Only use a release host you trust. Its updates run code on your PC."/>
<WrapPanel Margin="0,10"><Button Name="CheckUpdate" Content="Save feed and check"/><Button Name="DownloadUpdate" Content="Download update" IsEnabled="False"/><Button Name="InstallUpdate" Content="Install and restart" IsEnabled="False"/><Button Name="CancelUpdate" Content="Cancel download/check" IsEnabled="False"/></WrapPanel>
<TextBlock Name="LastUpdateCheck" Text="Not checked in this session." Foreground="#929BB5" Margin="0,6"/>
<TextBlock Text="Release notes" FontSize="18" Margin="0,12,0,6"/><TextBox Name="ReleaseNotes" Text="Check for updates to read what changed." Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<TextBlock Name="UpdateStatus" Text="Not connected: a release host must be configured before updates are available." Foreground="#B195FF"/>
<TextBlock Text="This preview is unsigned. HTTPS and SHA-256 verify transport and file integrity; they do not provide an independent publisher signature. No background checks or automatic hardware changes." Foreground="#929BB5" Margin="0,18"/>
</StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Optimize my PC" Tag="&#xE945;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Guided GPU optimization" FontSize="26" FontWeight="SemiBold"/>
<TextBlock Text="1. Check compatibility   /   2. Baseline   /   3. Review change   /   4. Retest   /   5. Decide" Foreground="#B195FF" Margin="0,12"/>
<Border Name="GuideStatusCard" Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="WORKFLOW STATUS" Foreground="#929BB5" FontSize="11" FontWeight="SemiBold"/>
<TextBlock Name="GuideStage" Text="Ready to begin" FontSize="23" FontWeight="SemiBold"/>
<TextBlock Name="GuideNextAction" Foreground="#EFF0FA" FontSize="15"/>
<TextBlock Name="GuideDevice" Margin="0,8" Foreground="#D8C8FF"/>
<TextBlock Name="GuideMessage" Foreground="#B0B5CC" FontSize="12"/>
</StackPanel></Border>
<TextBlock Text="This workflow tries a 90% NVIDIA power ceiling. It runs three baseline GPU tests, pauses for your approval, then applies and verifies the change and runs three retests. Allow about five minutes of testing plus review time. Higher game FPS is not guaranteed." Foreground="#B0B5CC" Margin="0,10"/>
<WrapPanel><Button Name="GuideDetect" Content="1. Check compatibility"/><Button Name="GuideBaseline" Content="2. Run baseline" IsEnabled="False"/><Button Name="GuideApply" Content="3. Review, apply and retest" IsEnabled="False"/></WrapPanel>
<WrapPanel><Button Name="GuideKeep" Content="Keep current limit" IsEnabled="False"/><Button Name="GuideRestore" Content="Restore original" Background="#28233D" IsEnabled="False"/><Button Name="GuideStop" Content="Cancel / restore" Background="#28233D" IsEnabled="False"/><Button Name="GuideExport" Content="Export guided report" IsEnabled="False"/></WrapPanel>
<TextBlock Name="GuideRecovery" Foreground="#D8C8FF" Margin="0,10"/>
<Border Style="{StaticResource Card}" Margin="0,12,12,14"><StackPanel>
<TextBlock Text="MEASURED RESULTS" Foreground="#929BB5" FontSize="11" FontWeight="SemiBold"/>
<TextBlock Name="GuideResultTitle" FontSize="21" FontWeight="SemiBold"/>
<UniformGrid Columns="3" Margin="0,8,0,12">
 <StackPanel Margin="0,0,12,0"><TextBlock Text="BASELINE MEDIAN" Foreground="#929BB5" FontSize="11"/><TextBlock Name="GuideBeforeScore" Text="--" FontSize="24" FontWeight="SemiBold" Margin="0,2"/><TextBlock Text="draws/s" Foreground="#929BB5" FontSize="12"/></StackPanel>
 <StackPanel Margin="0,0,12,0"><TextBlock Text="RETEST MEDIAN" Foreground="#929BB5" FontSize="11"/><TextBlock Name="GuideAfterScore" Text="--" FontSize="24" FontWeight="SemiBold" Margin="0,2"/><TextBlock Text="draws/s" Foreground="#929BB5" FontSize="12"/></StackPanel>
 <StackPanel><TextBlock Text="MEDIAN CHANGE" Foreground="#929BB5" FontSize="11"/><TextBlock Name="GuideChange" Text="--" FontSize="24" FontWeight="SemiBold" Foreground="#D8C8FF" Margin="0,2"/><TextBlock Text="descriptive comparison" Foreground="#929BB5" FontSize="12"/></StackPanel>
</UniformGrid>
<TextBlock Name="GuideRecommendationLabel" Text="TEST RECOMMENDATION" Foreground="#B195FF" FontSize="11" FontWeight="SemiBold"/>
<TextBlock Name="GuideRecommendation" FontSize="15"/>
<TextBlock Text="Three runs per setting. A small change or overlapping score ranges does not establish a performance benefit. Shader throughput is measured in draws/s, not game FPS." Foreground="#929BB5" FontSize="12"/>
<Expander Header="Full comparison details" Foreground="#EFF0FA" Margin="0,10,0,0" HorizontalContentAlignment="Stretch"><TextBox Name="GuideVerdict" MinHeight="160" MaxHeight="420" Margin="0,8,0,0"/></Expander>
</StackPanel></Border>
<TextBlock Text="Cancellation or a failed retest attempts restoration. A crash may require restoration on the next launch. No automatic startup writes, clock changes or voltage changes. Peak power is not energy use; three-run comparisons are descriptive, not stability certification." Foreground="#929BB5" Margin="0,14"/>
</StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Game overlay" Tag="&#xE7F4;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Your game, three readings." FontSize="26" FontWeight="SemiBold"/>
<TextBlock Text="CPU temperature, GPU temperature and FPS in a small, click-through panel. Keep PC Insight open or minimized while playing." Foreground="#B0B5CC" Margin="0,8,0,20"/>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="Ctrl + Alt + O" FontSize="28" FontWeight="SemiBold" Foreground="#D8C8FF"/>
<CheckBox Name="EnableOverlayHotkey" Content="Enable this hotkey while PC Insight is open" Foreground="#EFF0FA" FontSize="15" Margin="0,12,0,18"/>
<WrapPanel><Button Name="ToggleOverlay" Content="Show overlay"/></WrapPanel>
<TextBlock Name="OverlayStatus" Text="Overlay off. Enable the hotkey, focus your game and press Ctrl+Alt+O." Foreground="#B0B5CC"/>
<TextBlock Name="LastFpsCapture" Text="No game capture yet." Foreground="#929BB5" FontSize="12"/>
<WrapPanel><Button Name="ExportFpsDetails" Content="Export FPS details" Background="#28233D" IsEnabled="False"/></WrapPanel>
</StackPanel></Border>
<TextBlock Text="Use windowed or borderless mode; exclusive fullscreen may hide the panel. The overlay follows the foreground app and appears on that screen. Press the hotkey again to stop capture and hide it." Foreground="#B0B5CC"/>
<TextBlock Text="Missing readings show --. If temperatures or FPS are unavailable, try Reopen as administrator. CPU shows the highest reported CPU temperature; GPU max means the hottest GPU core when more than one GPU reports a reading." Foreground="#929BB5"/>
<TextBlock Text="FPS is the app presentation rate over about two seconds, not a benchmark score or a count of generated/displayed frames. It may be unavailable in some games. The overlay pauses for PC Insight tests, tuning actions and updates. No game files are modified." Foreground="#929BB5"/>
</StackPanel></ScrollViewer></TabItem>
   <TabItem Header="About" Tag="&#xE897;"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><Image Name="AboutLogo" Source="{DynamicResource PCInsightLogo}" MaxWidth="420" Height="140" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="PC Insight"/><TextBlock Name="AboutVersion" Foreground="#B0B5CC" FontSize="14" Margin="0,4,0,12"/></StackPanel><WrapPanel DockPanel.Dock="Top"><Button Name="OpenAppFolder" Content="Open app folder"/><Button Name="OpenDataFolder" Content="Open saved data folder"/></WrapPanel><TextBox Text="PC Insight - Windows desktop preview&#10;&#10;Reads Windows hardware information using CIM. NVIDIA live utilization, temperature and power are collected when nvidia-smi is already installed in a known vendor location. GPU sensor availability depends on vendor and driver support. CPU temperature and reported clocks are read through the bundled LibreHardwareMonitorLib on the Live sensors tab. CPU, RAM copy and GPU shader benchmarks are included. The optional Game overlay shows application presentation FPS and CPU/GPU temperatures. Effective-clock analysis and definitive thermal-throttling diagnosis are not implemented.&#10;&#10;Overview scans are snapshots. Live sensors offers short recordings and continuous monitoring. Continuous sessions retain the latest 300 samples. Sampling is subject to query latency. Missing data stays unavailable. There are no population rankings or invented bottleneck scores.&#10;&#10;All processing and saved results stay on this PC. No account, telemetry upload, downloaded drivers or background service. Exported reports contain hardware models and driver versions; review before sharing.&#10;&#10;System changes include installed Windows power plans and supported NVIDIA GPU power-limit reductions after review. GPU originals are saved before writes and read back after apply/restore. Closing the app does not restore settings. Use Restore previous plan for Windows power plans or Restore saved GPU limit on Tuning for GPU changes. Recovery information survives app restarts.&#10;&#10;This preview is unsigned. Hardware support varies. Administrator access alone does not guarantee readings. See README.md for setup, limitations, recovery and the development roadmap."/></DockPanel></TabItem>
  </TabControl>
