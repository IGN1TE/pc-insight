      <Grid Height="140" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><TextBlock Text="125°C" VerticalAlignment="Top" FontSize="10" Foreground="#8E9FBC"/><TextBlock Text="0°C" VerticalAlignment="Bottom" FontSize="10" Foreground="#8E9FBC"/></Grid><Border Grid.Column="1" Background="#0D1628" BorderBrush="#384969" BorderThickness="0,0,0,1"><Viewbox Stretch="Fill"><Canvas Name="TemperatureChart" Width="800" Height="150" ClipToBounds="True"/></Viewbox></Border></Grid>
