<DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="85"/>
<DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="85"/>
<DataGridTextColumn Header="Peak" Binding="{Binding MaxText}" Width="85"/>
