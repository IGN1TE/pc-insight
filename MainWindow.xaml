   <TabItem Header="Overview" Tag="&#xE80F;"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,0,4,0">
    <TextBlock Text="Your PC, at a glance" FontSize="40" FontWeight="Bold" Margin="0,0,0,4"/>
    <TextBlock Text="Live readings. Deeper diagnostics. Know your hardware." Foreground="#B2BED5" FontSize="14" Margin="2,0,0,12"/>
    <WrapPanel Margin="0,0,0,8"><Button Name="DashboardTest" Content="▶  Run monitored test" IsEnabled="False"/><Button Name="Scan" Content="⌕  Scan PC" Background="#263653"/><Button Name="DashboardRecord" Content="Record sensors" Background="#263653"/><TextBlock Name="ScanTime" Foreground="#8E9FBC" Text="Start with a hardware scan" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/></WrapPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Background="{StaticResource HardwareCardBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="▎ CPU" Foreground="#B69AFF" FontSize="12" FontWeight="Bold"/><TextBlock Name="CPUModel" Text="Your processor" FontSize="26" FontWeight="Bold"/><TextBlock Name="CPUDetails" Text="Scan PC to read cores and threads" Foreground="#A8B5CE" FontSize="12"/></StackPanel>
      <Grid Grid.Row="1" Margin="0,6,0,12" MinHeight="146"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Temperature" Foreground="#A8B5CE" FontSize="12"/><TextBlock Name="CPUTemp" Text="—" FontSize="46" FontWeight="Bold" Margin="0,0,0,2"/><TextBlock Name="CPUReadingTime" Text="Record sensors to read temperature" Foreground="#8E9FBC" FontSize="10"/></StackPanel><Image Grid.Column="1" Source="{StaticResource ProcessorArt}" Stretch="Uniform" Opacity="0.95" IsHitTestVisible="False"/></Grid>
      <Border Grid.Row="2" BorderBrush="#36445F" BorderThickness="0,1,0,0" Padding="0,10,0,0"><TextBlock Name="CPUPower" Text="Package power · No reading yet" Foreground="#B7C5DD" FontSize="12"/></Border>
     </Grid></Border>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Background="{StaticResource HardwareCardBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.55*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▎ GPU" Foreground="#63DDEC" FontSize="12" FontWeight="Bold"/><TextBlock Name="GPUModel" Text="Your graphics card" FontSize="20" FontWeight="Bold"/><TextBlock Text="Temperature" FontSize="11" Foreground="#A8B5CE" Margin="0,5,0,0"/><TextBlock Name="GPUTemp" Text="—" FontSize="32" FontWeight="Bold" Margin="0,0,0,4"/><TextBlock Name="GPUReadingTime" Text="Record sensors to read temperature" Foreground="#8E9FBC" FontSize="10"/></StackPanel><Image Grid.Column="1" Source="{StaticResource GraphicsArt}" Stretch="Uniform" Margin="6,20,0,0" IsHitTestVisible="False"/></Grid></Border>
